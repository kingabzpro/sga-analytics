# AI tips via Mistral (@mistralai/mistralai). Get a key at https://console.mistral.ai
MISTRAL_API_KEY=

# Legacy AI keys (no longer used for tips since the switch to Mistral, but kept
# for reference / future use). Tips fall back to rule-based if no AI key is set.
HF_TOKEN=
FIREWORKS_API_KEY=

# Domain Rating via Open PageRank (https://openpagerank.keywordseverywhere.com)
# Get a free key (opr_live_...) from their dashboard. Without it, a rough
# on-page estimate is used instead.
OPEN_PAGE_RANK_API_KEY=

# Real Core Web Vitals (LCP/INP/CLS/FCP/TBT/TTFB) via Google PageSpeed Insights
# v5. Create a free API key in Google Cloud Console (enable "PageSpeed Insights
# API"). Without it, Speed falls back to on-page heuristics.
PAGESPEED_API_KEY=
