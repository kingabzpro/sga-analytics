# AI tips via Mistral (@mistralai/mistralai). Get a key at https://console.mistral.ai
MISTRAL_API_KEY=

# Legacy AI keys (no longer used for tips since the switch to Mistral, but kept
# for reference / future use). Tips fall back to rule-based if no AI key is set.
HF_TOKEN=
FIREWORKS_API_KEY=

# Actual Ahrefs Domain Rating. The free public endpoint requires a free API key
# starting 2026-08-10; set it now to keep deployments future-proof.
AHREFS_API_KEY=

# Secondary authority source via Open PageRank
# (https://openpagerank.keywordseverywhere.com)
# Get a free key (opr_live_...) from their dashboard. Without it, a rough
# on-page estimate is used instead.
OPEN_PAGE_RANK_API_KEY=

# Low-latency real-user Core Web Vitals via the Chrome UX Report API. Create a
# Google Cloud API key and enable "Chrome UX Report API". Without it, Speed
# falls back to on-page heuristics.
PAGESPEED_API_KEY=

# Optional mode: set to "psi" to always run Lighthouse. The default tries CrUX
# first, then uses PSI when a URL/origin has no CrUX record.
SPEED_DATA_MODE=crux
